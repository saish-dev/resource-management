# Copy to .env (git-ignored). Local-only values; never reuse in other environments.
POSTGRES_USER=rm
POSTGRES_PASSWORD=rm_local_only
POSTGRES_DB=resource_management
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by apps/api (host access to the compose db)
DATABASE_URL=postgresql://rm:rm_local_only@localhost:5432/resource_management?schema=public
REDIS_URL=redis://localhost:6379

# Sign-in (OIDC). Register apps in Microsoft Entra and Google Cloud; redirect URI: <API_URL>/api/v1/auth/<provider>/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host-run web (pnpm dev); containers get these from docker-compose.yml
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
